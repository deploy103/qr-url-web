# /etc/qrurl/qrurl.env
# Copy to /etc/qrurl/qrurl.env, adjust and `chmod 640 && chown root:qrurl`.

# --- network -----------------------------------------------------------------
# Always bind to the loopback interface; Nginx is the only thing that may reach
# the application.
QRURL_ADDR=127.0.0.1:8080

# Public origin. Short URL QR payloads are built from this value.
QRURL_BASE_URL=https://url.mvtp.cloud

# The application sits behind Nginx, so the X-Real-IP / X-Forwarded-For headers
# it sets can be trusted for rate limiting and logging. The headers are only
# believed when the request actually arrives from one of QRURL_TRUSTED_PROXIES,
# so a caller that reaches the port directly cannot forge its own address.
QRURL_TRUST_PROXY=true
QRURL_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- storage -----------------------------------------------------------------
QRURL_DATA_DIR=/var/lib/qrurl
# Derived from QRURL_DATA_DIR unless set explicitly:
#QRURL_DB=/var/lib/qrurl/qrurl.db
#QRURL_QR_DIR=/var/lib/qrurl/qr
#QRURL_BACKUP_DIR=/var/lib/qrurl/backups

# --- behaviour ---------------------------------------------------------------
QRURL_TIMEZONE=Asia/Seoul
QRURL_SESSION_TTL=12h
QRURL_CLEANUP_INTERVAL=5m
QRURL_BACKUP_INTERVAL=24h
QRURL_BACKUP_KEEP=14
QRURL_MAX_BODY_BYTES=65536

# Serve the public, stateless QR generator on /. Set to false to make the whole
# service administrator only (the 001-999 redirects keep working either way).
QRURL_PUBLIC_QR=true

# Optionally restrict the anonymous generator to given networks, for example
# QRURL_PUBLIC_QR_ALLOW=10.0.0.0/24 to keep it on the LAN. Empty means everyone.
QRURL_PUBLIC_QR_ALLOW=

# Redirects per minute per address. The 001-999 space is small enough to walk,
# so this caps how fast anyone can enumerate it. Normal use is far below it.
QRURL_REDIRECT_RATE=120

# Refuse to start when another process already owns the data directory. Only
# turn this off if you are certain the other process is gone.
QRURL_SINGLE_INSTANCE=true

# --- security ----------------------------------------------------------------
# Both must stay true in production, where TLS is terminated by Nginx.
QRURL_SECURE_COOKIE=true
QRURL_HSTS=true

# --- logging -----------------------------------------------------------------
QRURL_LOG_LEVEL=info
QRURL_LOG_FORMAT=json

# --- first start only --------------------------------------------------------
# If no administrator exists yet the service creates one. Set a password here or
# leave it unset and read the generated one from `journalctl -u qrurl`, then
# change it with `qrurl setpassword`. Remove these lines afterwards.
#QRURL_ADMIN_USERNAME=admin
#QRURL_ADMIN_PASSWORD=change-me-to-something-long
